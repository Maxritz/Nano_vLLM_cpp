// Mirrors hip_ops.hip store_kv_kernel. Bit-exact.
#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { int kv_heads; int head_dim; int total; } pc;
layout(std430, binding = 0) buffer BKEY { float key[]; };
layout(std430, binding = 1) buffer BVAL { float value[]; };
layout(std430, binding = 2) buffer BKCS { float k_cache[]; };
layout(std430, binding = 3) buffer BVCS { float v_cache[]; };
layout(std430, binding = 4) buffer BSLOT { int32_t slot_map[]; }; // slot_mapping[token]
void main() {
    uint idx = uint(gl_WorkGroupID.x) * 256 + gl_LocalInvocationIndex;
    if (idx >= uint(pc.total)) return;
    int d = pc.kv_heads * pc.head_dim;          // kv stride per token
    uint token = idx / uint(d), off = idx % uint(d);
    int slot = slot_map[int(token)];
    if (slot < 0) return;
    k_cache[uint(slot) * uint(d) + off] = key[idx];
    v_cache[uint(slot) * uint(d) + off] = value[idx];
}
