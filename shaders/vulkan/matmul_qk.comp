// TILE=16 twin of matmul_q8 over raw K-quant super-blocks (QK_K=256).
// kind: 2=Q4_0 (18B/blk, 32 vals), 10=Q2_K (84B/blk), 12=Q4_K (144B/blk),
// 13=Q5_K (176B/blk), 14=Q6_K (210B/blk). Zero VRAM bloat: dequant inline.
// Q2_K mirrors host dequant_q2_k_block exactly:
// [16B scales][64B qs][fp16 d][fp16 dmin]; y = d*(sc&15)*q - dmin*(sc>>4).
// Q4_0 mirrors host dequant_q4_0_block: [fp16 d][16B qs, low nibble first];
// y = d*(q-8). Q4_0 blocks hold 32 values (not 256): index math branches.
#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_debug_printf : enable
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform PC { int m, n, k; int kind; uint woff; uint yoff; } pc;
layout(std430, binding = 0) buffer BX { float x[]; };
layout(std430, binding = 1) buffer BWQ { uint8_t wq[]; };
layout(std430, binding = 2) buffer BY { float y[]; };
shared float As[16][16];
shared float Bs[16][16];
uint fp16_to_float_u(uint h) {
    uint sign = (h & 0x8000u) << 16;
    uint exp = (h >> 10) & 0x1fu;
    uint mant = h & 0x3ffu; uint bits;
    if (exp == 0u) {
        if (mant == 0u) { bits = sign; }
        else { // fp16 subnormal: value = mant * 2^-24; normalize into f32
            uint e = 127u - 14u, m = mant;
            while ((m & 0x400u) == 0u) { m <<= 1u; e -= 1u; }
            bits = sign | (e << 23) | ((m & 0x3FFu) << 13);
        }
    }
    else if (exp == 0x1fu) { bits = sign | 0x7f800000u | (mant << 13); }
    else { bits = sign | ((exp - 15u + 127u) << 23) | (mant << 13); }
    return bits;
}
float qk_q2(uint base, uint i) {
    uint g = i >> 4, j = i & 15u;
    float d = uintBitsToFloat(fp16_to_float_u(uint(wq[base + 80u]) | (uint(wq[base + 81u]) << 8)));
    float dmin = uintBitsToFloat(fp16_to_float_u(uint(wq[base + 82u]) | (uint(wq[base + 83u]) << 8)));
    uint sb = wq[base + g];
    float dl = d * float(sb & 0xFu);
    float ml = dmin * float(sb >> 4);
    uint byte = (g >> 3) * 32u + (g & 1u) * 16u + j;
    uint q = (wq[base + 16u + byte] >> (((g >> 1) & 3u) * 2u)) & 3u;
    return dl * float(q) - ml;
}
float qk_q4_0(uint base, uint i) {
    float d = uintBitsToFloat(fp16_to_float_u(uint(wq[base]) | (uint(wq[base + 1u]) << 8)));
    uint nib = i < 16u ? (wq[base + 2u + i] & 0xFu) : (wq[base + 2u + i - 16u] >> 4);
    return d * (float(nib) - 8.0);
}
float qk_q4(uint base, uint i) {
    uint dh = uint(wq[base]) | (uint(wq[base + 1u]) << 8);
    uint dmh = uint(wq[base + 2u]) | (uint(wq[base + 3u]) << 8);
    float d = uintBitsToFloat(fp16_to_float_u(dh));
    float dmin = uintBitsToFloat(fp16_to_float_u(dmh));
    uint j = i >> 5, e = i & 31u;
    uint b4 = base + 4u;
    uint sc, mn;
    if (j < 4u) { sc = wq[b4 + j] & 63u; mn = wq[b4 + j + 4u] & 63u; }
    else { sc = (wq[b4 + j + 4u] & 0xFu) | ((wq[b4 + j - 4u] >> 6) << 4); mn = (wq[b4 + j + 4u] >> 4) | ((wq[b4 + j] >> 6) << 4); }
    uint qb = wq[base + 16u + (j >> 1) * 32u + e];
    uint q = (qb >> ((j & 1u) * 4u)) & 0xFu;
    return d * float(sc) * float(q) - dmin * float(mn);
}
float qk_q5(uint base, uint i) {
    uint group = i >> 6, slot = (i & 63u) >> 5, l = i & 31u;
    uint is = group * 2u;
    uint u1 = 1u << (group * 2u), u2 = 2u << (group * 2u);
    uint b4 = base + 4u;
    uint j = is + slot;
    uint sc, mn;
    if (j < 4u) { sc = wq[b4 + j] & 63u; mn = wq[b4 + j + 4u] & 63u; }
    else { sc = (wq[b4 + j + 4u] & 0xFu) | ((wq[b4 + j - 4u] >> 6) << 4); mn = (wq[b4 + j + 4u] >> 4) | ((wq[b4 + j] >> 6) << 4); }
    uint ql = base + 48u, qh = base + 16u;
    uint qhl = wq[qh + l];
    uint q = slot == 0u ? (wq[ql + group*32u + l] & 0xFu) : (wq[ql + group*32u + l] >> 4);
    uint hbit = slot == 0u ? (qhl & u1) : (qhl & u2);
    float d = uintBitsToFloat(fp16_to_float_u(uint(wq[base]) | (uint(wq[base + 1u]) << 8)));
    float dmin = uintBitsToFloat(fp16_to_float_u(uint(wq[base + 2u]) | (uint(wq[base + 3u]) << 8)));
    return d * float(sc) * float(q + (hbit != 0u ? 16 : 0)) - dmin * float(mn);
}
float qk_q6(uint base, uint i) {
    uint ha = i >> 7, t = i & 127u;
    uint ql = base + ha * 64u, qh = base + 128u + ha * 32u, sb = base + 192u + ha * 8u;
    uint dh = uint(wq[base + 208u]) | (uint(wq[base + 209u]) << 8);
    float d = uintBitsToFloat(fp16_to_float_u(dh));
    uint l = t & 31u, slot = t >> 5, is = l >> 4;
    uint qhl = wq[qh + l];
    uint q; int s;
    uint su;
    if (slot == 0u) { q = (wq[ql + l] & 0xFu) | (((qhl >> 0) & 3u) << 4); su = wq[sb + is]; }
    else if (slot == 1u) { q = (wq[ql + l + 32u] & 0xFu) | (((qhl >> 2) & 3u) << 4); su = wq[sb + is + 2u]; }
    else if (slot == 2u) { q = (wq[ql + l] >> 4) | (((qhl >> 4) & 3u) << 4); su = wq[sb + is + 4u]; }
    else { q = (wq[ql + l + 32u] >> 4) | (((qhl >> 6) & 3u) << 4); su = wq[sb + is + 6u]; }
    s = su > 127u ? int(su) - 256 : int(su);
    return d * float(s) * (float(q) - 32.0);
}
void main() {
    uint tx = gl_LocalInvocationIndex & 15u, ty = gl_LocalInvocationIndex >> 4;
    uint row = gl_WorkGroupID.y * 16 + ty, col = gl_WorkGroupID.x * 16 + tx;
    uint bb = pc.kind == 2 ? 18u : (pc.kind == 10 ? 84u : (pc.kind == 12 ? 144u : (pc.kind == 13 ? 176u : 210u)));
    float acc = 0.0;
    for (int kt = 0; kt < (pc.k + 15)/16; ++kt) {
        uint ak = uint(kt)*16 + tx, row_abs = gl_WorkGroupID.y*16 + ty;
        As[ty][tx] = (row_abs < uint(pc.m) && ak < uint(pc.k)) ? x[row_abs*uint(pc.k)+ak] : 0.0;
        uint br = gl_WorkGroupID.x*16 + tx, bk = uint(kt)*16 + ty, idx = br*uint(pc.k)+bk;
        float wv = 0.0;
        if (br < uint(pc.n) && bk < uint(pc.k)) {
            uint b = pc.kind == 2 ? idx >> 5 : idx >> 8, i = pc.kind == 2 ? idx & 31u : idx & 255u;
             wv = (pc.kind == 2) ? qk_q4_0(b*bb + pc.woff, i) : ((pc.kind == 10) ? qk_q2(b*bb + pc.woff, i) : ((pc.kind == 12) ? qk_q4(b*bb + pc.woff, i) : (pc.kind == 13 ? qk_q5(b*bb + pc.woff, i) : qk_q6(b*bb + pc.woff, i))));
         }
         Bs[ty][tx] = wv;
         barrier();
         for (int a = 0; a < 16; ++a) acc += As[ty][a] * Bs[a][tx];
         barrier();
     }
    if (row < uint(pc.m) && col < uint(pc.n)) {
        y[row*uint(pc.n)+col + pc.yoff/4u] = acc;
    }
}
