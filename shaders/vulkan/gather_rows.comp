// Mirrors hip_ops.hip gather_rows_kernel (last-token gather). Bit-exact.
#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { int rows; int cols; int total; } pc;
layout(std430, binding = 0) buffer BROWS { float rws[]; };
layout(std430, binding = 1) buffer BIDX { int32_t indices[]; };
layout(std430, binding = 2) buffer BY { float y[]; };
void main() {
    uint gid = uint(gl_WorkGroupID.x) * 256 + gl_LocalInvocationIndex;
    if (gid >= uint(pc.total)) return;
    int src = indices[gid / uint(pc.cols)];
    y[gid] = rws[uint(src) * uint(pc.cols) + (gid % uint(pc.cols))];
}
