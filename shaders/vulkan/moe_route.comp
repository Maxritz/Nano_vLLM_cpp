// MoE router: top-K expert selection (Qwen SOFTMAX_TOPK path).
// Mirrors hip_ops.hip moe_route_kernel. One block per token, 32 threads,
// only thread 0 active. Softmax + top-K selection sort in FLOAT
// (HIP uses double for reference parity; float precision is sufficient
// for top-K index selection on GPU).
#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#define MAX_E 256
layout(local_size_x = 32) in;
layout(push_constant) uniform PC { int rows, E, K, norm; } pc;
layout(std430, binding = 0) buffer BLOGITS { float logits[]; };
layout(std430, binding = 1) buffer BIDX { int32_t idx[]; };
layout(std430, binding = 2) buffer BSCORE { float score[]; };
shared float pr[MAX_E];
shared int ix[MAX_E];
void main() {
    if (gl_LocalInvocationIndex != 0u) return;
    int t = int(gl_WorkGroupID.x);
    if (t >= pc.rows) return;
    int E = pc.E;
    if (E > MAX_E || E <= 0) return;
    int base = t * E;
    float maxv = -1e30f;
    for (int i = 0; i < E; ++i) { float v = logits[base + i]; if (v > maxv) maxv = v; }
    float sum = 0.0f;
    for (int i = 0; i < E; ++i) { pr[i] = exp(logits[base + i] - maxv); sum += pr[i]; }
    float inv = 1.0f / sum;
    for (int i = 0; i < E; ++i) { pr[i] *= inv; ix[i] = i; }
    int K = pc.K;
    for (int i = 0; i < K; ++i) {
        int best = i;
        for (int j = i + 1; j < E; ++j) if (pr[j] > pr[best]) best = j;
        float tp = pr[i]; pr[i] = pr[best]; pr[best] = tp;
        int ti = ix[i]; ix[i] = ix[best]; ix[best] = ti;
        idx[t * K + i] = ix[i];
        score[t * K + i] = pr[i];
    }
    if (pc.norm != 0) {
        float s = 0.0f;
        for (int i = 0; i < K; ++i) s += pr[i];
        float sinv = 1.0f / s;
        for (int i = 0; i < K; ++i) score[t * K + i] = pr[i] * sinv;
    }
}
