// Elementwise add: a[i] += b[i]. Used to fold the MoE expert scratch buffer
// into the residual stream after the fused route+FFN kernel.
#version 450
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { int n; } pc;
layout(std430, binding = 0) buffer BA { float a[]; };
layout(std430, binding = 1) buffer BB { float b[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (int(i) >= pc.n) return;
    a[i] += b[i];
}
