// Mirrors hip_ops.hip rope_kernel (rotary embedding). Bit-exact.
#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { int tokens; int heads; int head_dim; int64_t stride; } pc;
layout(std430, binding = 0) buffer BDATA { float data[]; };
layout(std430, binding = 1) buffer BPOS { int64_t positions[]; };
layout(std430, binding = 2) buffer BFREQ { float inv_freq[]; };
void main() {
    int half_dim = pc.head_dim / 2;
    uint idx = uint(gl_WorkGroupID.x) * 256 + gl_LocalInvocationIndex;
    uint total = uint(pc.tokens) * uint(pc.heads) * uint(half_dim);
    if (idx >= total) return;
    uint per_token = uint(pc.heads) * uint(half_dim);
    uint token = idx / per_token;
    uint rem = idx % per_token;
    uint head = rem / uint(half_dim);
    uint d = rem % uint(half_dim);
    float pos = float(positions[token]);
    float freq = pos * inv_freq[d];
    float c = cos(freq), s = sin(freq);
    uint base = uint(token) * uint(pc.stride) + uint(head) * uint(pc.head_dim);
    float x1 = data[base + d];
    float x2 = data[base + d + uint(half_dim)];
    data[base + d] = x1*c - x2*s;
    data[base + d + uint(half_dim)] = x2*c + x1*s;
}
